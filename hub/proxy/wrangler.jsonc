{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "vars": {
    "HUB_WEB_URL": "https://agent-hub-psi-five.vercel.app"
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "ComputerRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ComputerRelay"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
