{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-kit.local/hub/protocol/2",
  "title": "Agent Hub protocol, version 2",
  "description": "Single source of truth for the connector API (agentctl <-> backend), the browser API (web UI <-> proxy), and the relay frames (proxy <-> backend). Uses only this JSON Schema subset so the stdlib Python validator can check it: type (string or list), enum, const, required, properties, additionalProperties (boolean or schema), items, minItems, maxItems, minLength, maxLength, pattern, minimum, maximum, $ref to #/$defs/*, anyOf (only for nullable refs). No oneOf/allOf/format.",
  "$defs": {
    "Timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "NullableTimestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "WorkspaceId": {"type": "string", "pattern": "^ws_[a-z2-7]{16}$"},
    "RunId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
    "TaskId": {"type": "string", "pattern": "^T[1-9][0-9]{0,2}$"},
    "Username": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,31}$"},
    "ComputerId": {"type": "string", "pattern": "^c_[a-z2-7]{16}$"},
    "DecisionId": {"type": "string", "pattern": "^D[0-9]{1,4}$"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "OptionKey": {"type": "string", "pattern": "^[A-Za-z0-9]{1,8}$"},

    "WorkspaceStatus": {"enum": ["ONLINE", "OFFLINE", "STOPPED"]},
    "RunStatus": {"enum": ["RUNNING", "DONE", "BLOCKED", "FAILED"]},
    "TaskStatus": {"enum": ["PENDING", "READY", "RUNNING", "REVIEW", "FIX_REQUIRED", "PASSED", "MERGED", "BLOCKED", "FAILED"]},
    "WorkerStatus": {"enum": ["IDLE", "BUSY", "BLOCKED", "BROKEN"]},
    "AgentState": {"enum": ["idle", "working", "blocked", "done", "unknown", "absent"]},
    "DecisionKind": {"enum": ["blocker", "repair", "scope_exception", "abandon", "worker_approval", "question", "finish"]},
    "LocalDecisionStatus": {"enum": ["PENDING", "ANSWERED", "CANCELLED", "DECIDED_BY_OPUS"]},
    "HubDecisionStatus": {"enum": ["OPEN", "SENT", "REPLY_SENT", "DELIVERED", "APPLIED", "ANSWERED_ELSEWHERE", "REJECTED", "CANCELLED", "ROUTINE"]},
    "AnswerChannel": {"enum": ["chat", "hub", "opus"]},
    "CommandType": {"enum": ["answer", "reply", "prompt"]},
    "CommandStatus": {"enum": ["QUEUED", "HELD", "DELIVERED", "REJECTED", "FAILED", "EXPIRED"]},
    "AckStatus": {"enum": ["DELIVERED", "HELD", "REJECTED", "FAILED"]},
    "DocumentKind": {"enum": ["final_report", "final_diff", "decision", "research", "plan", "review", "other"]},
    "DocumentFormat": {"enum": ["markdown", "diff", "text"]},

    "ApiError": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}
    },

    "Agent": {
      "description": "The orchestrator. name = kitstart.agent_name(repo). screen = last lines of its pane (null when upload.orchestrator_screen is off).",
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "model", "effort", "herdr_state", "session_id", "screen"],
      "properties": {
        "name": {"type": "string", "maxLength": 64},
        "kind": {"type": "string", "maxLength": 32},
        "model": {"type": "string", "maxLength": 128},
        "effort": {"type": ["string", "null"], "maxLength": 32},
        "herdr_state": {"$ref": "#/$defs/AgentState"},
        "session_id": {"type": ["string", "null"], "maxLength": 128},
        "screen": {"type": ["array", "null"], "items": {"type": "string"}, "maxItems": 200}
      }
    },
    "Worker": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "status", "status_reason", "run_id", "task_id", "agent_name", "kind", "model", "effort", "herdr_state", "since"],
      "properties": {
        "slot": {"type": "string", "pattern": "^worker-[0-9]{1,2}$"},
        "status": {"$ref": "#/$defs/WorkerStatus"},
        "status_reason": {"type": ["string", "null"], "maxLength": 500},
        "run_id": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]},
        "agent_name": {"type": ["string", "null"], "maxLength": 64},
        "kind": {"type": "string", "maxLength": 32},
        "model": {"type": "string", "maxLength": 128},
        "effort": {"type": ["string", "null"], "maxLength": 32},
        "herdr_state": {"$ref": "#/$defs/AgentState"},
        "since": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },
    "ScoutRound": {
      "type": "object", "additionalProperties": false, "required": ["n", "questions", "evidence_path", "at"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "questions": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 50},
        "evidence_path": {"type": ["string", "null"], "maxLength": 512},
        "at": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },
    "Scout": {
      "description": "Research rounds of the active run (the scout is a Claude subagent inside the orchestrator; no live pane).",
      "type": "object", "additionalProperties": false, "required": ["run_id", "rounds_used", "max_rounds", "readiness", "rounds"],
      "properties": {
        "run_id": {"$ref": "#/$defs/RunId"},
        "rounds_used": {"type": "integer", "minimum": 0},
        "max_rounds": {"type": "integer", "minimum": 0},
        "readiness": {"type": ["string", "null"], "enum": ["READY", "NOT_READY", null]},
        "rounds": {"type": "array", "items": {"$ref": "#/$defs/ScoutRound"}, "maxItems": 20}
      }
    },
    "Task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "status", "worker", "depends_on", "major_repairs", "max_repairs", "known_issues"],
      "properties": {
        "id": {"$ref": "#/$defs/TaskId"},
        "title": {"type": "string", "maxLength": 60},
        "summary": {"type": ["string", "null"], "maxLength": 300},
        "status": {"$ref": "#/$defs/TaskStatus"},
        "worker": {"type": ["string", "null"]},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/TaskId"}, "maxItems": 20},
        "major_repairs": {"type": "integer", "minimum": 0},
        "max_repairs": {"type": "integer", "minimum": 0},
        "known_issues": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "Problem": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "type", "since", "decision_id", "note"],
      "properties": {
        "task_id": {"type": ["string", "null"]},
        "type": {"type": "string", "maxLength": 64},
        "since": {"$ref": "#/$defs/NullableTimestamp"},
        "decision_id": {"type": ["string", "null"]},
        "note": {"type": "string", "maxLength": 1000}
      }
    },
    "Finish": {
      "type": "object", "additionalProperties": false, "required": ["decision_id", "choice", "result", "branch", "pushed", "at"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/DecisionId"},
        "choice": {"$ref": "#/$defs/OptionKey"},
        "result": {"type": "string", "maxLength": 1000},
        "branch": {"type": ["string", "null"], "maxLength": 255},
        "pushed": {"type": ["boolean", "null"]},
        "at": {"$ref": "#/$defs/Timestamp"}
      }
    },
    "Run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "title", "goal", "status", "created_at", "base_branch", "integration_branch", "gate", "tasks", "problems", "report_path", "finish"],
      "properties": {
        "run_id": {"$ref": "#/$defs/RunId"},
        "title": {"type": ["string", "null"], "maxLength": 80},
        "goal": {"type": ["string", "null"], "maxLength": 500},
        "status": {"$ref": "#/$defs/RunStatus"},
        "created_at": {"$ref": "#/$defs/NullableTimestamp"},
        "base_branch": {"type": ["string", "null"], "maxLength": 255},
        "integration_branch": {"type": "string", "maxLength": 255},
        "gate": {"type": "object", "additionalProperties": false, "required": ["status", "at"],
          "properties": {"status": {"type": ["string", "null"], "enum": ["PASS", "FAIL", null]}, "at": {"$ref": "#/$defs/NullableTimestamp"}}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/Task"}, "maxItems": 20},
        "problems": {"type": "array", "items": {"$ref": "#/$defs/Problem"}, "maxItems": 50},
        "report_path": {"type": ["string", "null"], "maxLength": 512},
        "finish": {"anyOf": [{"$ref": "#/$defs/Finish"}, {"type": "null"}]}
      }
    },
    "Snapshot": {
      "description": "The whole live status of one workspace. Overwrites the previous one. Max 256 KB serialized.",
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "workspace_id", "session_id", "taken_at", "kit_version", "orchestrator", "workers", "scout", "runs", "orchestrator_last_activity_at"],
      "properties": {
        "protocol": {"const": 2},
        "workspace_id": {"$ref": "#/$defs/WorkspaceId"},
        "session_id": {"type": "string", "maxLength": 64},
        "taken_at": {"$ref": "#/$defs/Timestamp"},
        "kit_version": {"type": ["string", "null"], "maxLength": 64},
        "orchestrator": {"$ref": "#/$defs/Agent"},
        "workers": {"type": "array", "items": {"$ref": "#/$defs/Worker"}, "maxItems": 10},
        "scout": {"anyOf": [{"$ref": "#/$defs/Scout"}, {"type": "null"}]},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/Run"}, "maxItems": 200},
        "orchestrator_last_activity_at": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },

    "Option": {
      "type": "object", "additionalProperties": false, "required": ["key", "label", "consequence"],
      "properties": {"key": {"$ref": "#/$defs/OptionKey"}, "label": {"type": "string", "minLength": 1, "maxLength": 300}, "consequence": {"type": ["string", "null"], "maxLength": 300}}
    },
    "Evidence": {
      "type": "object", "additionalProperties": false, "required": ["code", "note", "bad"],
      "properties": {"code": {"type": "string", "maxLength": 300}, "note": {"type": "string", "maxLength": 300}, "bad": {"type": "boolean"}}
    },
    "Approval": {
      "type": "object", "additionalProperties": false, "required": ["command", "cwd", "why"],
      "properties": {"command": {"type": "string", "maxLength": 2000}, "cwd": {"type": ["string", "null"], "maxLength": 512}, "why": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 10}}
    },
    "FollowupOption": {
      "type": "object", "additionalProperties": false, "required": ["key", "label", "value", "input"],
      "properties": {
        "key": {"$ref": "#/$defs/OptionKey"},
        "label": {"type": "string", "minLength": 1, "maxLength": 300},
        "value": {"type": ["string", "null"], "maxLength": 255},
        "input": {"type": "boolean"}
      }
    },
    "Followup": {
      "description": "Second question asked when the first choice is in `when` (finish: which branch). An option with input=true takes a typed value.",
      "type": "object", "additionalProperties": false, "required": ["when", "question", "options", "validate"],
      "properties": {
        "when": {"type": "array", "items": {"$ref": "#/$defs/OptionKey"}, "minItems": 1},
        "question": {"type": "string", "maxLength": 300},
        "options": {"type": "array", "items": {"$ref": "#/$defs/FollowupOption"}, "minItems": 1, "maxItems": 8},
        "validate": {"type": ["string", "null"], "enum": ["branch", null]}
      }
    },
    "FollowupAnswer": {
      "type": "object", "additionalProperties": false, "required": ["choice", "label", "value"],
      "properties": {"choice": {"$ref": "#/$defs/OptionKey"}, "label": {"type": "string"}, "value": {"type": "string", "maxLength": 255}}
    },
    "Answer": {
      "description": "Mirrors state.json decisions[D].answer. channel=opus for routine decisions.",
      "type": "object", "additionalProperties": false, "required": ["choice", "label", "note", "channel", "by", "at", "quote", "followup"],
      "properties": {
        "choice": {"type": "string", "maxLength": 300},
        "label": {"type": "string", "maxLength": 300},
        "note": {"type": "string", "maxLength": 4000},
        "channel": {"$ref": "#/$defs/AnswerChannel"},
        "by": {"type": "string", "maxLength": 128},
        "at": {"$ref": "#/$defs/Timestamp"},
        "quote": {"type": ["string", "null"], "maxLength": 8192},
        "followup": {"anyOf": [{"$ref": "#/$defs/FollowupAnswer"}, {"type": "null"}]}
      }
    },
    "Decision": {
      "description": "One scheduler decision as the connector sees it in state.json. agent = the worker slot holding task_id, else 'orchestrator'.",
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "decision_id", "kind", "task_id", "agent", "title", "question", "options", "recommend", "followup", "local_status", "answer", "consumed_by", "opened_at", "cancel_reason", "evidence", "note", "approval"],
      "properties": {
        "run_id": {"$ref": "#/$defs/RunId"},
        "decision_id": {"$ref": "#/$defs/DecisionId"},
        "kind": {"$ref": "#/$defs/DecisionKind"},
        "task_id": {"type": ["string", "null"]},
        "agent": {"type": "string", "pattern": "^(orchestrator|worker-[0-9]{1,2})$"},
        "title": {"type": "string", "maxLength": 300},
        "question": {"type": "string", "maxLength": 8000},
        "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}, "maxItems": 8},
        "recommend": {"type": ["string", "null"]},
        "followup": {"anyOf": [{"$ref": "#/$defs/Followup"}, {"type": "null"}]},
        "local_status": {"$ref": "#/$defs/LocalDecisionStatus"},
        "answer": {"anyOf": [{"$ref": "#/$defs/Answer"}, {"type": "null"}]},
        "consumed_by": {"type": ["string", "null"], "maxLength": 500},
        "opened_at": {"$ref": "#/$defs/Timestamp"},
        "cancel_reason": {"type": ["string", "null"], "maxLength": 1000},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/Evidence"}, "maxItems": 20},
        "note": {"type": ["string", "null"], "maxLength": 1000},
        "approval": {"anyOf": [{"$ref": "#/$defs/Approval"}, {"type": "null"}]}
      }
    },
    "Event": {
      "description": "One state.json event. n = per-run increasing number (log_event).",
      "type": "object", "additionalProperties": false, "required": ["n", "at", "kind", "data"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "at": {"$ref": "#/$defs/Timestamp"},
        "kind": {"type": "string", "maxLength": 64},
        "data": {"type": "object"}
      }
    },
    "Document": {
      "type": "object", "additionalProperties": false, "required": ["path", "run_id", "kind", "title", "format", "sha256", "bytes", "truncated", "content"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^/].*$"},
        "run_id": {"type": ["string", "null"]},
        "kind": {"$ref": "#/$defs/DocumentKind"},
        "title": {"type": "string", "maxLength": 300},
        "format": {"$ref": "#/$defs/DocumentFormat"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "truncated": {"type": "boolean"},
        "content": {"type": "string", "maxLength": 1048576}
      }
    },
    "CommandBody": {
      "description": "answer: choice (+note, followup, value). reply/prompt: text.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "choice": {"$ref": "#/$defs/OptionKey"},
        "note": {"type": "string", "maxLength": 4000},
        "followup": {"$ref": "#/$defs/OptionKey"},
        "value": {"type": "string", "maxLength": 255},
        "text": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    },
    "Command": {
      "description": "Hub -> system. Delivered to the connector, applied via the scheduler (answer) or typed to the orchestrator (reply, prompt).",
      "type": "object", "additionalProperties": false, "required": ["id", "type", "run_id", "decision_id", "body", "by", "created_at", "expires_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^cmd_[a-z2-7]{16}$"},
        "type": {"$ref": "#/$defs/CommandType"},
        "run_id": {"type": ["string", "null"]},
        "decision_id": {"type": ["string", "null"]},
        "body": {"$ref": "#/$defs/CommandBody"},
        "by": {"$ref": "#/$defs/Username"},
        "created_at": {"$ref": "#/$defs/Timestamp"},
        "expires_at": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },

    "PingResponse": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "min_protocol", "server_time", "version"],
      "properties": {"protocol": {"type": "integer"}, "min_protocol": {"type": "integer"}, "server_time": {"$ref": "#/$defs/Timestamp"}, "version": {"type": "string"}}
    },
    "HelloRequest": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "workspace_id", "session_id", "name", "path", "kit_version", "connector_version", "upload"],
      "properties": {
        "protocol": {"const": 2},
        "workspace_id": {"$ref": "#/$defs/WorkspaceId"},
        "session_id": {"type": "string", "pattern": "^ses_[a-z2-7]{16}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "path": {"type": "string", "maxLength": 1024},
        "kit_version": {"type": ["string", "null"], "maxLength": 64},
        "connector_version": {"type": "string", "maxLength": 64},
        "upload": {"$ref": "#/$defs/UploadSettings"}
      }
    },
    "HelloResponse": {
      "description": "What the backend already has, so the connector sends only differences. All empty when known=false (new or wiped DB).",
      "type": "object", "additionalProperties": false, "required": ["known", "server_time", "event_cursors", "decision_hashes", "document_hashes", "snapshot_hash"],
      "properties": {
        "known": {"type": "boolean"},
        "server_time": {"$ref": "#/$defs/Timestamp"},
        "event_cursors": {"type": "object", "description": "run_id -> last stored event n", "additionalProperties": {"type": "integer", "minimum": 0}},
        "decision_hashes": {"type": "object", "description": "'<run_id>/<decision_id>' -> sha256 of the canonical Decision JSON", "additionalProperties": {"$ref": "#/$defs/Sha256"}},
        "document_hashes": {"type": "object", "description": "path -> sha256 of content", "additionalProperties": {"$ref": "#/$defs/Sha256"}},
        "snapshot_hash": {"type": ["string", "null"]}
      }
    },
    "UploadSettings": {
      "type": "object", "additionalProperties": false, "required": ["documents", "diffs", "orchestrator_screen"],
      "properties": {"documents": {"type": "boolean"}, "diffs": {"type": "boolean"}, "orchestrator_screen": {"type": "boolean"}}
    },
    "GoodbyeRequest": {
      "type": "object", "additionalProperties": false, "required": ["session_id", "reason"],
      "properties": {"session_id": {"type": "string"}, "reason": {"enum": ["orchestrator_gone", "signal", "manual"]}}
    },
    "DecisionsBatch": {
      "type": "object", "additionalProperties": false, "required": ["decisions"],
      "properties": {"decisions": {"type": "array", "items": {"$ref": "#/$defs/Decision"}, "maxItems": 200}}
    },
    "EventsBatch": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "events"],
      "properties": {"run_id": {"$ref": "#/$defs/RunId"}, "events": {"type": "array", "items": {"$ref": "#/$defs/Event"}, "maxItems": 200}}
    },
    "EventsResponse": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "cursor"],
      "properties": {"run_id": {"$ref": "#/$defs/RunId"}, "cursor": {"type": "integer", "minimum": 0}}
    },
    "DocumentsBatch": {
      "description": "Max 5 MB serialized per request; split bigger uploads.",
      "type": "object", "additionalProperties": false, "required": ["documents"],
      "properties": {"documents": {"type": "array", "items": {"$ref": "#/$defs/Document"}, "maxItems": 50}}
    },
    "CommandsResponse": {
      "type": "object", "additionalProperties": false, "required": ["commands"],
      "properties": {"commands": {"type": "array", "items": {"$ref": "#/$defs/Command"}, "maxItems": 50}}
    },
    "AckRequest": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"$ref": "#/$defs/AckStatus"}, "reason": {"type": ["string", "null"], "maxLength": 2000}}
    },

    "WorkspaceSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "path", "status", "last_seen_at", "kit_version", "kit_outdated", "open_decisions", "problems", "orchestrator_state", "active_run", "archived", "upload", "orchestrator_last_activity_at", "computer_id", "computer_online"],
      "properties": {
        "id": {"$ref": "#/$defs/WorkspaceId"},
        "name": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/WorkspaceStatus"},
        "last_seen_at": {"$ref": "#/$defs/NullableTimestamp"},
        "kit_version": {"type": ["string", "null"]},
        "kit_outdated": {"type": "boolean"},
        "open_decisions": {"type": "integer", "minimum": 0},
        "problems": {"type": "integer", "minimum": 0},
        "orchestrator_state": {"type": ["string", "null"], "enum": ["idle", "working", "blocked", "done", "unknown", "absent", null]},
        "active_run": {"type": ["object", "null"], "additionalProperties": false, "required": ["run_id", "status", "title"],
          "properties": {"run_id": {"$ref": "#/$defs/RunId"}, "status": {"$ref": "#/$defs/RunStatus"}, "title": {"type": ["string", "null"]}}},
        "archived": {"type": "boolean"},
        "upload": {"anyOf": [{"$ref": "#/$defs/UploadSettings"}, {"type": "null"}]},
        "orchestrator_last_activity_at": {"$ref": "#/$defs/NullableTimestamp"},
        "computer_id": {"type": ["string", "null"], "pattern": "^c_[a-z2-7]{16}$"},
        "computer_online": {"type": "boolean"}
      }
    },
    "HubDecision": {
      "description": "A decision as the UI sees it: the scheduler's view plus the hub's delivery state. pending_command = the latest answer/reply command for it, if any.",
      "type": "object", "additionalProperties": false, "required": ["workspace_id", "hub_status", "status_reason", "updated_at", "pending_command", "decision"],
      "properties": {
        "workspace_id": {"$ref": "#/$defs/WorkspaceId"},
        "hub_status": {"$ref": "#/$defs/HubDecisionStatus"},
        "status_reason": {"type": ["string", "null"]},
        "updated_at": {"$ref": "#/$defs/Timestamp"},
        "pending_command": {"anyOf": [{"$ref": "#/$defs/UserCommand"}, {"type": "null"}]},
        "decision": {"$ref": "#/$defs/Decision"}
      }
    },
    "UserCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspace_id", "type", "run_id", "decision_id", "body", "status", "status_reason", "by", "created_at", "delivered_at", "expires_at"],
      "properties": {
        "id": {"type": "string"},
        "workspace_id": {"$ref": "#/$defs/WorkspaceId"},
        "type": {"$ref": "#/$defs/CommandType"},
        "run_id": {"type": ["string", "null"]},
        "decision_id": {"type": ["string", "null"]},
        "body": {"$ref": "#/$defs/CommandBody"},
        "status": {"$ref": "#/$defs/CommandStatus"},
        "status_reason": {"type": ["string", "null"]},
        "by": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/Timestamp"},
        "delivered_at": {"$ref": "#/$defs/NullableTimestamp"},
        "expires_at": {"$ref": "#/$defs/NullableTimestamp"}
      }
    },
    "WorkspaceDetail": {
      "type": "object", "additionalProperties": false, "required": ["workspace", "snapshot", "decisions_open", "commands_recent"],
      "properties": {
        "workspace": {"$ref": "#/$defs/WorkspaceSummary"},
        "snapshot": {"anyOf": [{"$ref": "#/$defs/Snapshot"}, {"type": "null"}]},
        "decisions_open": {"type": "array", "items": {"$ref": "#/$defs/HubDecision"}},
        "commands_recent": {"type": "array", "items": {"$ref": "#/$defs/UserCommand"}, "maxItems": 50}
      }
    },
    "AnswerRequest": {
      "type": "object", "additionalProperties": false, "required": ["choice"],
      "properties": {
        "choice": {"$ref": "#/$defs/OptionKey"},
        "note": {"type": "string", "maxLength": 4000},
        "followup": {"$ref": "#/$defs/OptionKey"},
        "value": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "TextRequest": {
      "description": "Body of reply (to a decision) and prompt (to the orchestrator).",
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 8192}}
    },
    "DocumentMeta": {
      "type": "object", "additionalProperties": false, "required": ["path", "run_id", "kind", "title", "format", "bytes", "truncated", "updated_at", "deleted"],
      "properties": {
        "path": {"type": "string"},
        "run_id": {"type": ["string", "null"]},
        "kind": {"$ref": "#/$defs/DocumentKind"},
        "title": {"type": "string"},
        "format": {"$ref": "#/$defs/DocumentFormat"},
        "bytes": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "updated_at": {"$ref": "#/$defs/Timestamp"},
        "deleted": {"type": "boolean"}
      }
    },
    "DocumentContent": {
      "type": "object", "additionalProperties": false, "required": ["meta", "content"],
      "properties": {"meta": {"$ref": "#/$defs/DocumentMeta"}, "content": {"type": "string"}}
    },
    "HistoryItem": {
      "description": "type=answer: my answer (hub or chat). reply/prompt: text I sent from the hub. routine: Opus's own call (DECIDED_BY_OPUS).",
      "type": "object", "additionalProperties": false,
      "required": ["id", "at", "type", "run_id", "decision_id", "title", "choice", "label", "text", "quote", "channel", "by", "status"],
      "properties": {
        "id": {"type": "string"},
        "at": {"$ref": "#/$defs/Timestamp"},
        "type": {"enum": ["answer", "reply", "prompt", "routine"]},
        "run_id": {"type": ["string", "null"]},
        "decision_id": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "choice": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "text": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]},
        "channel": {"type": ["string", "null"], "enum": ["chat", "hub", "opus", null]},
        "by": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]}
      }
    },
    "LoginRequest": {
      "type": "object", "additionalProperties": false, "required": ["username", "password", "remember"],
      "properties": {"username": {"$ref": "#/$defs/Username"}, "password": {"type": "string", "minLength": 1, "maxLength": 256}, "remember": {"type": "boolean"}}
    },
    "LoginResponse": {
      "type": "object", "additionalProperties": false, "required": ["token", "expires_at", "username"],
      "properties": {"token": {"type": "string", "minLength": 32}, "expires_at": {"$ref": "#/$defs/Timestamp"}, "username": {"$ref": "#/$defs/Username"}}
    },
    "PasswordChangeRequest": {
      "type": "object", "additionalProperties": false, "required": ["current", "new"],
      "properties": {"current": {"type": "string", "minLength": 1, "maxLength": 256}, "new": {"type": "string", "minLength": 12, "maxLength": 256}}
    },
    "Me": {
      "type": "object", "additionalProperties": false, "required": ["username", "computers"],
      "properties": {"username": {"$ref": "#/$defs/Username"}, "computers": {"type": "array", "items": {"$ref": "#/$defs/ComputerSummary"}}}
    },
    "ComputerSummary": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "online", "last_seen_at"],
      "properties": {"id": {"$ref": "#/$defs/ComputerId"}, "name": {"type": "string", "maxLength": 64}, "online": {"type": "boolean"}, "last_seen_at": {"$ref": "#/$defs/NullableTimestamp"}}
    },
    "AdminUserRequest": {
      "type": "object", "additionalProperties": false, "required": ["username"],
      "properties": {"username": {"$ref": "#/$defs/Username"}}
    },
    "AdminUserResponse": {
      "type": "object", "additionalProperties": false, "required": ["username", "password"],
      "properties": {"username": {"$ref": "#/$defs/Username"}, "password": {"type": "string", "minLength": 20, "maxLength": 64}}
    },
    "ComputerRegisterRequest": {
      "type": "object", "additionalProperties": false, "required": ["username", "password", "name"],
      "properties": {"username": {"$ref": "#/$defs/Username"}, "password": {"type": "string"}, "name": {"type": "string", "minLength": 1, "maxLength": 64}}
    },
    "ComputerRegisterResponse": {
      "type": "object", "additionalProperties": false, "required": ["computer_id", "computer_key", "proxy_public_key", "username"],
      "properties": {"computer_id": {"$ref": "#/$defs/ComputerId"}, "computer_key": {"type": "string", "minLength": 32}, "proxy_public_key": {"type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$"}, "username": {"$ref": "#/$defs/Username"}}
    },
    "WorkspaceIndexEntry": {
      "type": "object", "additionalProperties": false, "required": ["workspace_id", "name", "status", "last_seen_at"],
      "properties": {"workspace_id": {"$ref": "#/$defs/WorkspaceId"}, "name": {"type": "string", "maxLength": 128}, "status": {"$ref": "#/$defs/WorkspaceStatus"}, "last_seen_at": {"$ref": "#/$defs/NullableTimestamp"}}
    },
    "RelayRequest": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "method", "path", "query", "body", "assertion", "stream"],
      "properties": {
        "type": {"const": "req"}, "id": {"type": "string", "maxLength": 64},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "maxLength": 1024, "pattern": "^/api/v1/"},
        "query": {"type": "string", "maxLength": 2048, "pattern": "^[^?]*$"},
        "body": {"type": ["object", "array", "string", "number", "integer", "boolean", "null"]},
        "assertion": {"type": "string", "maxLength": 2048}, "stream": {"type": "boolean"}
      }
    },
    "RelayResponse": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "status", "body"],
      "properties": {"type": {"const": "res"}, "id": {"type": "string", "maxLength": 64}, "status": {"type": "integer", "minimum": 100, "maximum": 599}, "body": {"type": ["object", "array", "string", "number", "integer", "boolean", "null"]}}
    },
    "RelayStreamChunk": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "data"],
      "properties": {"type": {"const": "chunk"}, "id": {"type": "string", "maxLength": 64}, "data": {"type": "string", "maxLength": 900000}}
    },
    "RelayStreamEnd": {
      "type": "object", "additionalProperties": false, "required": ["type", "id", "status"],
      "properties": {"type": {"const": "end"}, "id": {"type": "string", "maxLength": 64}, "status": {"type": "integer"}}
    },
    "RelayCancel": {
      "type": "object", "additionalProperties": false, "required": ["type", "id"],
      "properties": {"type": {"const": "cancel"}, "id": {"type": "string", "maxLength": 64}}
    },
    "RelayHello": {
      "type": "object", "additionalProperties": false, "required": ["type", "protocol", "computer_id", "backend_version", "workspaces"],
      "properties": {"type": {"const": "hello"}, "protocol": {"const": 2}, "computer_id": {"$ref": "#/$defs/ComputerId"}, "backend_version": {"type": "string", "maxLength": 64}, "workspaces": {"type": "array", "items": {"$ref": "#/$defs/WorkspaceIndexEntry"}, "maxItems": 200}}
    },
    "RelayWorkspaces": {
      "type": "object", "additionalProperties": false, "required": ["type", "workspaces"],
      "properties": {"type": {"const": "workspaces"}, "workspaces": {"type": "array", "items": {"$ref": "#/$defs/WorkspaceIndexEntry"}, "maxItems": 200}}
    },
    "RelayPing": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "ping"}}},
    "RelayPong": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "pong"}}},
    "RelayPollResponse": {
      "type": "object", "additionalProperties": false, "required": ["frames"],
      "properties": {"frames": {"type": "array", "items": {"type": "object"}, "maxItems": 50}}
    },
    "RelayFramesRequest": {
      "type": "object", "additionalProperties": false, "required": ["frames"],
      "properties": {"frames": {"type": "array", "items": {"type": "object"}, "maxItems": 50}}
    },
    "Assertion": {
      "type": "object", "additionalProperties": false, "required": ["v", "sub", "cid", "rid", "exp"],
      "properties": {"v": {"const": 1}, "sub": {"$ref": "#/$defs/Username"}, "cid": {"$ref": "#/$defs/ComputerId"}, "rid": {"type": "string", "maxLength": 64}, "exp": {"type": "integer"}}
    },
    "List": {
      "description": "Generic list envelope: items + next cursor (null = no more). Item type is per route.",
      "type": "object", "additionalProperties": false, "required": ["items", "next"],
      "properties": {"items": {"type": "array"}, "next": {"type": ["string", "null"]}}
    },
    "StreamEvent": {
      "description": "One Server-Sent Event payload (event name = type). The UI refetches the named resource.",
      "type": "object", "additionalProperties": false, "required": ["type", "workspace_id", "at", "ref"],
      "properties": {
        "type": {"enum": ["workspace", "snapshot", "decision", "command", "document", "history"]},
        "workspace_id": {"$ref": "#/$defs/WorkspaceId"},
        "at": {"$ref": "#/$defs/Timestamp"},
        "ref": {"type": ["string", "null"], "description": "decision '<run>/<D>', command id, or document path"}
      }
    }
  }
}
