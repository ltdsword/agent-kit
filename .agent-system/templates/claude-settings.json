{
  "permissions": {
    "deny": [
      "Edit(.orchestrator/**/state.json)",
      "Edit(.orchestrator/**/decisions/**)",
      "Read(~/.config/agent-hub/**)",
      "Edit(~/.config/agent-hub/**)",
      "Read(~/.local/share/agent-hub/**)",
      "Edit(~/.local/share/agent-hub/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent-system/scripts/record-session.py\""}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent-system/scripts/record-session.py\""}]}
    ]
  }
}
