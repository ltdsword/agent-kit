#!/usr/bin/env bash
# Answer the orchestrator's pending decisions. USER ONLY: run it yourself in a normal terminal or a
# Herdr pane. It refuses to run when launched by Claude Code (CLAUDECODE set) or without a terminal.
#
#   decide                          # list pending decisions, pick one, choose, confirm
#   decide <run> <id> <KEY> ["note"] # answer directly (still asks you to confirm)
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
S=(python3 "$HERE/../scheduler.py" --workspace-root "$(cd "$HERE/../.." && pwd)" decision answer)
if [ $# -eq 0 ]; then
  exec "${S[@]}"
elif [ $# -ge 3 ]; then
  exec "${S[@]}" --run "$1" --id "$2" --choice "$3" --note "${4:-}"
else
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
